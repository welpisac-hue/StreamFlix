# Supabase Postgres
# Dashboard → Project Settings → Database → Connection string
# Use the URI format. Replace [YOUR-PASSWORD] with your database password.
#
# DATABASE_URL = Transaction pooler (app runtime, port 6543)
# DIRECT_URL   = Direct connection (Prisma migrations / db push, port 5432)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Optional: Supabase project URL (API) — not required for Prisma
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# NextAuth
# Production: set to your real public URL (https://your-domain.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-a-long-random-string-here"

# Required for production: obscure the admin dashboard URL (do NOT use "admin").
# Set BOTH to the same random slug so server rewrites + client links match.
# Example: ADMIN_PATH=ops-console-7f3a9c2b
ADMIN_PATH=""
NEXT_PUBLIC_ADMIN_PATH=""

# Optional: encrypt-at-rest helper passphrase for scripts using @/lib/obfuscate AES helpers
# APP_ENCRYPTION_KEY="long-random-passphrase"

# TMDB API — https://www.themoviedb.org/settings/api
# Accepts either the v3 API Key (32-char) OR the v4 Read Access Token (JWT starting with eyJ)
TMDB_API_KEY="your-tmdb-api-key-here"

# Contact Email (server-side only — never exposed to clients)
CONTACT_EMAIL="you@example.com"
