# Base44 development defaults — placeholders only.
# Real external secrets (TMDB_API_KEY, NEXTAUTH_SECRET) are delivered by the
# platform at /run/base44/app.env, which is loaded AFTER this file and wins.

# Local PostgreSQL (compose `db` service) with SSL enabled.
DATABASE_URL=postgresql://streamflix:streamflix@db:5432/streamflix?sslmode=require
DIRECT_URL=postgresql://streamflix:streamflix@db:5432/streamflix?sslmode=require

# NextAuth (dev)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-placeholder-secret

# Admin dashboard slug (obscured path)
ADMIN_PATH=ops-console-dev
NEXT_PUBLIC_ADMIN_PATH=ops-console-dev

# Contact form recipient
CONTACT_EMAIL=admin@streamflix.local

# TMDB — placeholder; real key comes from /run/base44/app.env
TMDB_API_KEY=dev-placeholder
